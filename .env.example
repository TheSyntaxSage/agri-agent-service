AGRI_APP_ENV=production
AGRI_DATABASE_URL=sqlite:///./agri_agent.db
AGRI_JAVA_BASE_URL=http://127.0.0.1:8080
AGRI_JAVA_SERVICE_TOKEN=replace-with-a-secret
AGRI_JAVA_TIMEOUT_SECONDS=3
# Demo fallback is still disabled unless APP_ENV=test and each request opts in.
AGRI_ALLOW_TEST_DEMO_FALLBACK=false
AGRI_MAX_AGENT_HOPS=2
# 大模型意图识别：base_url 与 api_key 同时非空时才启用，否则用关键词规则。
AGRI_LLM_BASE_URL=
AGRI_LLM_API_KEY=
AGRI_LLM_MODEL=deepseek-flash
AGRI_LLM_TIMEOUT_SECONDS=20
# 留空则不发送 reasoning 参数。
AGRI_LLM_REASONING_EFFORT=high
